# Changing this file on a push runs the Snapshot workflow, which commits a dated snapshot.
# The Croydon snapshot cut again from the same day's extract, now keeping the areas drawn as
# multipolygons: the same box and date, so nothing else in it should change.
# (Before: AREA='^London Borough of Croydon$' from Overpass; Addiscombe's walk was
# AROUND_PLACE=Addiscombe RADIUS_M=1200.)
SNAPSHOT_NAME=croydon
SNAPSHOT_DATE=2026-10-29
BBOX=-0.161906,51.286760,0.003282,51.423243
EXTRACT=https://download.geofabrik.de/europe/united-kingdom/england/greater-london-261029.osm.pbf
SNAPSHOT_GZIP=1
