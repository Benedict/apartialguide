# Changing this file on a push runs the Snapshot workflow, which commits a dated snapshot.
# Kenilworth, Warwickshire: the town, its castle and Abbey Fields, with a margin of the fields
# round it. Cut from Geofabrik's extract of Warwickshire, kept gzipped.
# (Cornwall's was BBOX=-5.36,50.18,-5.10,50.29 from Cornwall's; Weardale's -2.4,54.66,-1.9,54.86.)
SNAPSHOT_NAME=kenilworth
BBOX=-1.625,52.322,-1.540,52.368
EXTRACT="https://download.geofabrik.de/europe/united-kingdom/england/warwickshire-latest.osm.pbf"
SNAPSHOT_GZIP=1
