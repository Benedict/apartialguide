# Changing this file on a push runs the Snapshot workflow, which commits a dated snapshot.
# Weardale, with the heads of Teesdale and Allendale: the box of Underground's mining records,
# for a walk of the North Pennine orefield. Cut from Geofabrik's extracts of the three counties it
# crosses (Durham, Cumbria at Nenthead, Northumberland at Allenheads), kept gzipped.
# (Croydon's was AREA='^London Borough of Croydon$' with SNAPSHOT_NAME=croydon.)
SNAPSHOT_NAME=weardale
BBOX=-2.4,54.66,-1.9,54.86
EXTRACT="https://download.geofabrik.de/europe/united-kingdom/england/durham-latest.osm.pbf https://download.geofabrik.de/europe/united-kingdom/england/cumbria-latest.osm.pbf https://download.geofabrik.de/europe/united-kingdom/england/northumberland-latest.osm.pbf"
SNAPSHOT_GZIP=1
