# Changing this file on a push runs the Snapshot workflow, which commits a dated snapshot.
# The area: the box around the London Borough of Croydon's boundary, fetched from Overpass, as a
# whole borough is beyond the OSM API's limit. Kept gzipped: raw, it is more than one file may be.
# Asked again on 2026-10-30, after Overpass was at capacity.
# (Addiscombe's, the walk the site plays, was AROUND_PLACE=Addiscombe RADIUS_M=1200.)
SNAPSHOT_NAME=croydon
AREA='^London Borough of Croydon$'
SNAPSHOT_GZIP=1
