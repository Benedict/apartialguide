# Changing this file on a push runs the Snapshot workflow, which commits a dated snapshot.
# Cornwall's Camborne, Redruth and St Day mining district, the heart of the Cornish mining World
# Heritage Site: Underland's second orefield. Cut from Geofabrik's extract of Cornwall, kept gzipped.
# (Weardale's was BBOX=-2.4,54.66,-1.9,54.86 from Durham's, Cumbria's and Northumberland's.)
SNAPSHOT_NAME=cornwall
BBOX=-5.36,50.18,-5.10,50.29
EXTRACT="https://download.geofabrik.de/europe/united-kingdom/england/cornwall-latest.osm.pbf"
SNAPSHOT_GZIP=1
