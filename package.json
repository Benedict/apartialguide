{
	"name": "a-partial-guide",
	"private": true,
	"version": "0.0.1",
	"license": "AGPL-3.0-or-later",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:acceptance",
		"brand": "tsx scripts/brand.ts",
		"brand:kit": "tsx scripts/brand-kit.ts",
		"social": "tsx scripts/social.ts",
		"test:count": "tsx scripts/test-count.ts",
		"test:acceptance": "NODE_OPTIONS=\"--import tsx\" cucumber-js",
		"snapshot": "tsx scripts/snapshot.ts",
		"compare": "tsx scripts/compare.ts",
		"narrate:prompts": "tsx scripts/prompts.ts",
		"narrate": "tsx scripts/narrate.ts",
		"narrate:prune": "tsx scripts/prune.ts",
		"export": "tsx scripts/export.ts",
		"smoke": "tsx scripts/smoke.ts",
		"map-check": "tsx scripts/map-check.ts",
		"gaps": "tsx scripts/gaps.ts",
		"underland": "tsx scripts/underland.ts",
		"wikidata": "tsx scripts/wikidata.ts",
		"records": "tsx scripts/records.ts"
	},
	"devDependencies": {
		"@cucumber/cucumber": "^13.3.0",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@types/node": "^22",
		"@types/proj4": "^2.5.6",
		"esbuild": "^0.28.2",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "1.63.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tsx": "^4.23.15",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.3.0",
		"vitest": "^4.1.8"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^1.3.0",
		"astronomy-engine": "^2.1.19",
		"proj4": "^2.22.0",
		"satellite.js": "^6.0.2"
	}
}
