# Path to a dated OSM snapshot (npm run snapshot writes these).
SNAPSHOT_PATH=data/snapshots/addiscombe-2026-10-25.json
# The day the narrator believes it is. Defaults to the date in the snapshot file name.
# SNAPSHOT_DATE=2026-10-24
# Largest gap between stops along a street, in metres.
STOP_SPACING_M=50
# Where the reader starts, as lat,lon. Defaults to the first junction.
# START_AT=51.38,-0.07
# Used by npm run snapshot: minLon,minLat,maxLon,maxLat. To be tuned to the parade and Everton Road.
# BBOX=
# Prose written ahead of time (npm run narrate). Without it, every stop uses the template.
# NARRATION_PATH=data/narration/addiscombe.json
# Used by npm run narrate: the model, and the most stops to write in one run.
# NARRATOR_MODEL=claude-opus-5-5
# NARRATE_LIMIT=25
# Earlier maps of the same place (the History workflow writes them), for what has gone or been renamed.
# HISTORY_DIR=data/history
# Another account of the place, from Wikidata (the Wikidata workflow writes it). The newest file is used.
# WIKIDATA_DIR=data/wikidata
