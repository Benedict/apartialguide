# Path to a dated OSM snapshot (npm run snapshot writes these).
SNAPSHOT_PATH=data/snapshots/addiscombe-2026-10-24.json
# The day the narrator believes it is. Defaults to the date in the snapshot file name.
# SNAPSHOT_DATE=2026-10-24
# Largest gap between stops along a street, in metres.
STOP_SPACING_M=50
# Where the reader starts, as lat,lon. Defaults to the first junction.
# START_AT=51.38,-0.07
# Used by npm run snapshot: minLon,minLat,maxLon,maxLat. To be tuned to the parade and Everton Road.
# BBOX=
